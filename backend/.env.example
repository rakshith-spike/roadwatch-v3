# ROAD-WATCH Backend Environment Variables

# Application
APP_NAME=ROAD-WATCH API
APP_VERSION=1.0.0
DEBUG=False

# Server
HOST=0.0.0.0
PORT=8000

# MongoDB
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=roadwatch

# JWT
# Change to a secure 32+ character key in production
SECRET_KEY=your-secure-secret-key-here-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Grok AI (xAI) API Key
# Get your key from: https://console.x.ai/
GROK_API_KEY=your-grok-api-key-here
GROK_MODEL=grok-beta

# Frontend URL (for CORS)
FRONTEND_URL=https://your-frontend.vercel.app
CORS_ALLOW_ALL=false
