# ROAD-WATCH Backend Environment Variables

# Application
APP_NAME=ROAD-WATCH API
APP_VERSION=1.0.0
DEBUG=True

# Server
HOST=0.0.0.0
PORT=8000

# MongoDB
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=roadwatch

# JWT
SECRET_KEY=your-super-secret-key-change-in-production-roadwatch-2024
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
